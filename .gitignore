.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE / Editor folders
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 2. Node.js & React Frontend (Vite)
# ------------------------------------------------------------------------------
node_modules/
client/node_modules/

# Production build outputs
dist/
client/dist/
build/
client/build/
.vite/
client/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg-info/
.installed.cfg
*.egg
MANIFEST
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Unit Test & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

