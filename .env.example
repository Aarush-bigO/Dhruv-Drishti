# Dhruv Drishti — Environment Configuration Template
# Copy to .env and adjust values for local development or deployment

# Application Settings
STAGE=prod
DEBUG=false
APP_NAME="Dhruv Drishti"
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL / Amazon Aurora)
DATABASE_URL=postgresql+asyncpg://polar:polar_secret@localhost:5432/polar_twin
POSTGRES_USER=polar
POSTGRES_PASSWORD=polar_secret
POSTGRES_DB=polar_twin

# Backend & CORS Origins
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","https://sih-flax-nine.vercel.app","https://dhruv-drishti.vercel.app"]

# AWS Cloud Credentials & Region
AWS_REGION=ap-south-1
AWS_IOT_ENDPOINT=iot.ap-south-1.amazonaws.com
S3_ARCHIVE_BUCKET=dhruv-drishti-telemetry-archive
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:dhruv-drishti-critical-alerts

# Telemetry & Anomaly Detection Limits
VIBRATION_WARNING_THRESHOLD=3.5
VIBRATION_CRITICAL_THRESHOLD=5.0
PRESSURE_DROP_WARNING_HPA=4.0
BATTERY_SOC_CRITICAL=15.0
